# ============================================================================
# Nova Platform - Contract Deployment Configuration
# ============================================================================
# Copy this file to .env and fill in your values before deployment.
# Run: cp .env.example .env
#
# IMPORTANT: Use the format below WITHOUT the 'export' keyword for Makefile
# compatibility. The Makefile uses 'include .env' which requires VAR=value format.
# ============================================================================

# ============================================================================
# REQUIRED: Network & Wallet Configuration
# ============================================================================

# PRIVATE_KEY: The private key of the deployer account
# - This account will be the initial owner/admin of deployed contracts
# - Must have sufficient ETH/native token to pay for gas fees
# - SECURITY: Never commit your actual private key to version control!
# - NOTE: Do NOT use 'export' prefix - just VAR=value format
PRIVATE_KEY=<your_private_key>

# RPC_URL: The RPC endpoint URL for the target blockchain
# Examples:
#   - Local Anvil: http://localhost:8545
#   - Base Sepolia: https://sepolia.base.org
#   - Base Mainnet: https://mainnet.base.org
RPC_URL=https://sepolia.base.org


# (No additional env vars are required for on-chain app/version/instance operations.
# Deployments are performed via `make deploy-nova` and upgrades via `PROXY=... make upgrade-nova`.)

# ============================================================================
# OPTIONAL: Contract Verification (for `make verify-all-basescan`)
# ============================================================================

# BASESCAN_API_KEY: API key for Basescan contract verification
# - Get one at: https://basescan.org/myapikey
# - Required only for Basescan verification (Blockscout doesn't need API key)
# - NOTE: You may also use ETHERSCAN_API_KEY as a fallback if BASESCAN_API_KEY is unset.
BASESCAN_API_KEY=<your_basescan_api_key>
# ETHERSCAN_API_KEY=<your_etherscan_api_key>
